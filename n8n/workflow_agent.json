    },
    {
      "parameters": {
        "toolDescription": "Every input the readiness rubric needs, for one date: sleep, HRV vs baseline, resting HR delta, last hard session, body battery, and data gaps. Start here for any \"should I train / how am I recovering\" question.",
        "url": "http://tools:8000/tools/get_readiness_inputs",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "date",
              "value": "={{ $fromAI('date', 'Date in YYYY-MM-DD format. Use the as-of date from the system prompt unless the user asks about a different day.', 'string') }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
