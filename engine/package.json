{
  "name": "@fitness-ready/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Device-agnostic meaning layer for wearable data, served to AI assistants over MCP.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "mcp:stdio": "node --experimental-strip-types src/mcp/stdio.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.221.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
